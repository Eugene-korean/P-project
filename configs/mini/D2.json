{
  "stage": "D2",
  "title": "테스트: 저장장치 속도만 변경",
  "purpose": "자동 실행·합치기·분석 확인용 (결과는 쓰지 않음)",
  "common": {"model": "qwen", "storage": "raw", "cache": "cold", "evict": "drop",
             "warmup": 1, "n_predict": 8, "repeats": 1, "measure_disk": true,
             "lengths": "16,256,1024", "server_verbosity": 4},
  "conditions": [
    {"name": "read5M",   "args": {"io_read": "5M",  "measure_disk_mb": 32, "lengths": "16,256"}},
    {"name": "read20M",  "args": {"io_read": "20M", "measure_disk_mb": 128}},
    {"name": "read44M",  "args": {"io_read": "44M", "measure_disk_mb": 128}},
    {"name": "nolimit",  "args": {"measure_disk_mb": 64}},
    {"name": "ramdisk",  "args": {"kv_dir": "/dev/shm/kvcache", "cache": "warm", "measure_disk_mb": 64}}
  ]
}