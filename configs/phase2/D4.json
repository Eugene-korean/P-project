    "model": "both",
    "storage": "raw",
    "cache": "cold",
    "evict": "drop",
    "warmup": 2,
    "n_predict": 32,
    "repeats": 5,
    "measure_disk": true,
    "lengths": "1024,4096",
    "ctx": 4192,
    "server_verbosity": 4,
    "drop_caches_before_server": true
  },
